{
  "name": "hws-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:templates": "node scripts/verify-templates.mjs",
    "dev:pages": "vite --config pages/vite.config.ts",
    "build:pages": "vite build --config pages/vite.config.ts",
    "preview:pages": "vite preview --config pages/vite.config.ts --host 127.0.0.1 --port 5175",
    "dev:backend": "wrangler dev --config backend/wrangler.json --port 8787",
    "deploy:backend": "wrangler deploy --config backend/wrangler.json",
    "db:backend": "wrangler d1 migrations apply DB --config backend/wrangler.json --remote",
    "verify:backend": "node scripts/verify-backend.mjs",
    "verify:commerce": "node scripts/verify-commerce.mjs",
    "verify:storage": "node scripts/verify-storage.mjs",
    "verify:calendar": "node scripts/verify-calendar.mjs",
    "verify:creation": "node scripts/verify-creation.mjs",
    "verify:forms": "node scripts/verify-forms.mjs",
    "verify:publication": "node scripts/verify-publication.mjs",
    "deploy:domains": "node scripts/deploy-domains.mjs",
    "verify:devices": "node scripts/verify-device-access.mjs",
    "verify:editor-options": "node scripts/verify-idle-media-footer.mjs",
    "verify:imported-template": "node scripts/verify-imported-template.mjs",
    "verify:website-payments": "node scripts/verify-website-payments.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "package:source": "node scripts/package-source.mjs",
    "setup:upload": "node scripts/setup-upload-guard.mjs",
    "verify:mobile": "node scripts/verify-mobile.mjs",
    "verify:customer-security": "node scripts/verify-customer-security.mjs",
    "verify:security-hardening": "node scripts/verify-security-hardening.mjs",
    "postinstall": "node scripts/harden-build-dependencies.mjs",
    "verify:build-security": "node scripts/verify-build-security.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.3.5",
    "wrangler": "4.152.0",
    "miniflare": "4.20260730.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    },
    "js-yaml": "4.3.2",
    "brace-expansion@^1.1.7": "1.1.21",
    "brace-expansion@^5.0.0": "5.0.12",
    "fflate": "0.7.5",
    "image-size": "2.0.4",
    "ws": "8.21.0",
    "braces": "3.0.3"
  }
}
